{
  "name": "codecockpit",
  "version": "1.3.1",
  "description": "CodeCockpit — a desktop cockpit for managing multiple AI coding CLI sessions (Claude Code / Codex / OpenCode and more)",
  "main": "out/main/index.js",
  "author": {
    "name": "ITGuyVV",
    "email": "ITGuyVV@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/itguyvv/CodeCockpit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itguyvv/CodeCockpit.git"
  },
  "bugs": {
    "url": "https://github.com/itguyvv/CodeCockpit/issues"
  },
  "private": true,
  "keywords": [
    "claude-code",
    "opencode",
    "ai-coding",
    "electron",
    "terminal",
    "xterm",
    "pty",
    "developer-tools"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node node_modules/typescript/lib/tsc.js -b",
    "icons": "node scripts/build-icns.js",
    "dist": "electron-vite build && electron-builder --publish never && node scripts/rename-dist.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "CodeCockpit",
  "build": {
    "appId": "io.github.itguyvv.codecockpit",
    "copyright": "Copyright © 2026 ITGuyVV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  }
}
