{
  "name": "codecockpit",
  "version": "1.1.0",
  "description": "CodeCockpit — a desktop cockpit for managing multiple AI coding CLI sessions (Claude Code / openCode and more)",
  "main": "out/main/index.js",
  "author": "CodeCockpit Contributors",
  "license": "MIT",
  "private": true,
  "keywords": [
    "claude-code",
    "opencode",
    "ai-coding",
    "electron",
    "terminal",
    "xterm",
    "pty",
    "developer-tools"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node node_modules/typescript/lib/tsc.js -b",
    "dist": "electron-vite build && electron-builder --dir && node scripts/rename-dist.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "CodeCockpit",
  "build": {
    "appId": "com.codecockpit.app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
